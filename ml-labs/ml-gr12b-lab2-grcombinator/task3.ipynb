   "source": [
    "count = 0\n",
    "while (s:=input()) != '':\n",
    "    a = int(s)\n",
    "    if a <=2:\n",
    "        count+=0\n",
    "    elif a>=3 and a <=12:\n",
    "        count+=4.5\n",
    "    elif a>=65:\n",
    "        count+=8.25\n",
    "    else:\n",
    "        count+=12.75\n",
    "print(f\"{count:.2f}\")"
   ]
